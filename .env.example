# Copy this file to .env for local development.
# NEVER commit the real .env file — it's already in .gitignore.

# Postgres connection string. Render provides this automatically for a
# linked database — you only need to set it manually for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mapua_parking

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

NODE_ENV=development
PORT=3000
